# Copy this file to frontend/.env and fill in the values. Never commit frontend/.env.
# Everything here is visible to anyone using the website: only browser-safe (publishable) keys belong here.

VITE_API_BASE_URL=http://localhost:3000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: Google place suggestions + the interactive Google live map.
# Restrict it to your site's URLs (HTTP referrers) in Google Cloud.
VITE_GOOGLE_MAPS_BROWSER_KEY=
