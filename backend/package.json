{
  "name": "ride-hailing-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "seed:demo": "node --env-file-if-exists=.env scripts/seed-demo.js",
    "e2e": "node --env-file-if-exists=.env scripts/e2e-demo.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0"
  }
}

