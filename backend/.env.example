# Copy this file to backend/.env and fill in the values. Never commit backend/.env.
# Where to find the Supabase values: Supabase -> Project Settings -> API Keys. See docs/SETUP.md.

PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses Row Level Security. NEVER put this in the frontend.
SUPABASE_SECRET_KEY=

# Google Routes API (real road distance and time). Leave empty and set ROUTES_PROVIDER=mock to use estimates.
GOOGLE_MAPS_SERVER_KEY=
# google | mock (mock = straight-line estimate, clearly labelled in the app)
ROUTES_PROVIDER=google

# --- Optional: prices (defaults shown) ---
# BASE_FARE=40
# PER_KM_RATE=12
# PER_MINUTE_RATE=2

# --- Optional: matching ---
# OFFER_TTL_SECONDS=30
# INITIAL_RADIUS_KM=5
# EXPANDED_RADIUS_KM=10
# LOCATION_STALE_SECONDS=120
# RANKING_STRATEGY=proximity

# --- Optional: live tracking and safety alerts ---
# TRACK_MIN_MOVE_METERS=25
# TRACK_MAX_SILENCE_SECONDS=30
# ALERT_DEVIATION_MIN_KM=1.2
# ALERT_STOP_MINUTES=5

# --- Optional: demo ---
# Autopilot demo drivers (driver2 + driver3) take rides automatically when no one else is available. Demos only.
# DEMO_AUTOPILOT=on
# DEMO_AUTOPILOT_EMAILS=driver2@demo.ridehail.test,driver3@demo.ridehail.test
# SUPPORT_TRIAGE_SECONDS=60
# DEMO_PASSWORD=DemoPass#2025
